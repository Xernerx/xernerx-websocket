{
	"name": "@xernerx/websocket",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.4.13",
	"type": "module",
	"main": "./dist/main.cjs",
	"module": "./dist/main.js",
	"types": "./dist/main.d.ts",
	"description": "Xernerx Websocket",
	"homepage": "www.xernerx.com",
	"files": [
		"src",
		"dist"
	],
	"exports": {
		"require": {
			"types": "./dist/main.d.cts",
			"default": "./dist/main.cjs"
		},
		"import": {
			"types": "./dist/main.d.ts",
			"default": "./dist/main.js"
		}
	},
	"scripts": {
		"commit": "prettier --write . && changeset",
		"ship": "pnpm run build && changeset version && git add . && git commit -m \"chore: release\" && changeset tag && git push --follow-tags",
		"docs": "typedoc",
		"build": "pnpm i && tsup && attw --pack && pnpm run docs",
		"dev": "pnpm i && pnpm link && tsup --watch",
		"test": "pnpm install --engine-strict=true"
	},
	"keywords": [
		"framework"
	],
	"author": "Xernerx Studios",
	"license": "MIT",
	"packageManager": "npm@10.9.8",
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.2",
		"@changesets/cli": "^3.0.1",
		"@types/node": "^26.4.0",
		"@types/ws": "^8.18.1",
		"prettier": "^3.6.2",
		"tsup": "^8.5.1",
		"typedoc-github-theme": "^0.3.1",
		"typedoc-plugin-extras": "^4.0.1",
		"typedoc-plugin-zod": "^1.4.2",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">="
	},
	"dependencies": {
		"@xernerx/terminal": "^1.1.11"
	}
}
